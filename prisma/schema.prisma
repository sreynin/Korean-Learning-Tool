// Korean Learning Lab persistence.
//
// Design notes:
//  - Enum-like columns (format, status, level, scene type, animation, …) are
//    stored as String. SQLite has no native enum, and the authoritative lists
//    already live in src/types/* and are enforced by Zod at every boundary.
//    Duplicating them here would create a second source of truth.
//  - Deeply nested, always-read-together values (a project's pipeline, a
//    lesson's sections and quiz) are stored as JSON text. They are never
//    queried by their inner fields, so tables would add joins for no gain.
//  - Scenes ARE their own table: they are ordered, individually edited, and
//    will carry media references later.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// passed to PrismaClient via a driver adapter (see src/server/db/client.ts).
datasource db {
  provider = "sqlite"
}

model Project {
  id          String @id
  title       String
  topic       String
  description String @default("")

  format         String // shorts | long | both
  status         String // draft | in_progress | completed
  level          String // beginner | elementary | intermediate | advanced
  targetLanguage String // korean | english | chinese
  contentStyle   String
  visualStyle    String

  shortsDurationSeconds Int?
  longDurationSeconds   Int?

  /// JSON: Record<PipelineStage, { status, updatedAt }>
  pipeline String

  /// JSON: VoiceSettings — language, voice, speed, pitch, volume.
  voiceSettings String?

  createdAt DateTime
  updatedAt DateTime

  lesson     Lesson?
  storyboard Storyboard?

  @@index([updatedAt])
  @@index([status])
  @@index([format])
}

model Lesson {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title             String
  hook              String
  learningObjective String
  level             String
  language          String

  /// JSON: LessonSection[]
  sections String
  /// JSON: QuizQuestion[]
  quiz     String

  generatedAt DateTime
  /// Model id that produced it, or "mock".
  model       String
  editedAt    DateTime?
}

model Storyboard {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generatedAt DateTime
  model       String
  editedAt    DateTime?

  scenes Scene[]
}

model Scene {
  id           String     @id
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  /// 1-based position. Renumbered from array order on every save.
  order Int

  type         String
  duration     Int
  koreanText   String
  englishText  String
  romanization String
  narration    String
  visualPrompt String
  animation    String
  background   String
  transition   String

  audio SceneAudio?

  // Deliberately not unique on (storyboardId, order): scenes are upserted in
  // place so generated audio survives a storyboard edit, and a reorder puts
  // two scenes on the same order for one statement. The service renumbers
  // from array position on every save, which is the real guarantee.
  @@index([storyboardId])
  @@index([storyboardId, order])
}

model SceneAudio {
  id      String @id @default(uuid())
  sceneId String @unique
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  /// File name inside the audio directory. Bytes live on disk, not in the row.
  fileName        String
  mimeType        String
  byteSize        Int
  durationSeconds Float

  /// The settings this clip was rendered with, so the UI can show drift.
  language  String
  voiceId   String
  voiceName String
  speed     Float
  pitch     Float
  volume    Float

  /// "elevenlabs" or "mock".
  provider    String
  generatedAt DateTime
}
