// Korean Learning Lab persistence.
//
// Design notes:
//  - Enum-like columns (format, status, level, scene type, animation, …) are
//    stored as String. SQLite has no native enum, and the authoritative lists
//    already live in src/types/* and are enforced by Zod at every boundary.
//    Duplicating them here would create a second source of truth.
//  - Deeply nested, always-read-together values (a project's pipeline, a
//    lesson's sections and quiz) are stored as JSON text. They are never
//    queried by their inner fields, so tables would add joins for no gain.
//  - Scenes ARE their own table: they are ordered, individually edited, and
//    will carry media references later.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// passed to PrismaClient via a driver adapter (see src/server/db/client.ts).
datasource db {
  provider = "sqlite"
}

model Project {
  id          String @id
  title       String
  topic       String
  description String @default("")

  format         String // shorts | long | both
  status         String // draft | in_progress | completed
  level          String // beginner | elementary | intermediate | advanced
  targetLanguage String // korean | english | chinese
  contentStyle   String
  visualStyle    String

  shortsDurationSeconds Int?
  longDurationSeconds   Int?

  /// JSON: Record<PipelineStage, { status, updatedAt }>
  pipeline String

  /// JSON: VoiceSettings — language, voice, speed, pitch, volume.
  voiceSettings String?

  /// JSON: CaptionSettings. Null means the creator has never configured them,
  /// which is what makes the captions stage derivable rather than assumed.
  captionSettings String?

  /// Set when the creator marks the preview reviewed. Null means not reviewed.
  previewReviewedAt DateTime?

  /// Set when the video was published — either by a finished upload, or by
  /// the creator saying they published it themselves.
  publishedAt DateTime?
  /// The watch URL, from the upload or recorded by hand.
  youtubeUrl  String?

  createdAt DateTime
  updatedAt DateTime

  lesson      Lesson?
  storyboard  Storyboard?
  renderJobs  RenderJob[]
  metadata    Metadata[]
  publishJobs PublishJob[]

  @@index([updatedAt])
  @@index([status])
  @@index([format])
}

model Lesson {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title             String
  hook              String
  learningObjective String
  level             String
  language          String

  /// JSON: LessonSection[]
  sections String
  /// JSON: QuizQuestion[]
  quiz     String

  generatedAt DateTime
  /// Model id that produced it, or "mock".
  model       String
  editedAt    DateTime?
}

model Storyboard {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generatedAt DateTime
  model       String
  editedAt    DateTime?

  scenes Scene[]
}

model Scene {
  id           String     @id
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  /// 1-based position. Renumbered from array order on every save.
  order Int

  type         String
  duration     Int
  koreanText   String
  englishText  String
  romanization String
  narration    String
  visualPrompt String
  animation    String
  background   String
  transition   String

  /// JSON: string[] — substrings of koreanText to highlight in captions.
  highlightTerms String?

  audio SceneAudio?

  // Deliberately not unique on (storyboardId, order): scenes are upserted in
  // place so generated audio survives a storyboard edit, and a reorder puts
  // two scenes on the same order for one statement. The service renumbers
  // from array position on every save, which is the real guarantee.
  @@index([storyboardId])
  @@index([storyboardId, order])
}

model SceneAudio {
  id      String @id @default(uuid())
  sceneId String @unique
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  /// File name inside the audio directory. Bytes live on disk, not in the row.
  fileName        String
  mimeType        String
  byteSize        Int
  durationSeconds Float

  /// The settings this clip was rendered with, so the UI can show drift.
  language  String
  voiceId   String
  voiceName String
  speed     Float
  pitch     Float
  volume    Float

  /// "elevenlabs" or "mock".
  provider    String
  generatedAt DateTime
}

/// A single attempt to render a project into a video file.
///
/// The row is the source of truth for job state, which is what lets the worker
/// run outside the HTTP request — and later, in a separate process entirely.
model RenderJob {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// shorts | long — which cut this job renders.
  format   String @default("shorts")
  /// pending | queued | processing | completed | failed
  status   String @default("pending")
  /// 0-100.
  progress Int    @default(0)

  /// Why the job failed. Null while it has not.
  errorMessage   String?
  /// File name inside the render directory. Null until a render succeeds.
  outputFileName String?
  /// Still taken from the finished video, used as the library thumbnail.
  posterFileName String?
  /// Media type of the finished file, e.g. video/mp4.
  contentType    String?
  /// Size of the finished file in bytes.
  byteSize       Int?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([projectId, createdAt])
  @@index([status])
}

/// YouTube publishing metadata for one cut of a project.
///
/// Keyed by (projectId, format) because a `both` project needs a different
/// title and description for its Short than for its long-form video.
model Metadata {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// shorts | long
  format String

  title         String
  description   String
  /// JSON: string[] — hashtags, written with their leading #.
  hashtags      String
  /// JSON: string[] — plain keywords.
  tags          String
  thumbnailText String
  pinnedComment String

  generatedAt DateTime
  /// Model id that produced it, or "mock".
  model       String
  editedAt    DateTime?

  @@unique([projectId, format])
}

/// The YouTube channel this installation is connected to.
///
/// One row at a time, identified by `SINGLETON_ACCOUNT_ID`: this is a
/// single-creator tool, and a second connected channel would raise a question
/// ("which one does this project publish to?") that nothing in the UI asks.
///
/// **The two token columns hold ciphertext, never a usable credential.** They
/// are written and read only through src/server/youtube/token-store.ts, which
/// refuses to store anything at all when no encryption key is configured.
model YouTubeAccount {
  id String @id

  channelId    String
  channelTitle String

  /// AES-256-GCM, encoded `v1.<iv>.<tag>.<ciphertext>`.
  accessTokenEncrypted  String
  /// The long-lived one. Encrypted the same way.
  refreshTokenEncrypted String
  /// When the access token stops working and has to be refreshed.
  expiresAt             DateTime

  /// JSON: string[] — scopes the creator actually granted.
  scopes String

  connectedAt DateTime
  updatedAt   DateTime
}

/// A single attempt to publish one cut of a project to YouTube.
///
/// Same model as RenderJob and for the same reason: an upload outlives the
/// request that starts it. The row also keeps what the creator submitted and
/// what YouTube gave back, so the record of a publish survives a later
/// re-publish rather than being overwritten by it.
model PublishJob {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// shorts | long — which cut this job publishes.
  format   String
  /// pending | queued | uploading | processing | completed | failed
  status   String @default("pending")
  /// 0-100, across the upload.
  progress Int    @default(0)

  /// Why the job failed. Null while it has not.
  errorMessage   String?
  /// Something that went wrong without stopping the publish, e.g. a thumbnail
  /// an unverified channel was not allowed to set.
  warningMessage String?

  // What the creator filled in on the form, kept so a finished job explains
  // what was actually sent rather than what the metadata says today.
  title       String
  description String
  /// JSON: string[]
  tags        String
  visibility  String
  categoryId  String
  language    String
  thumbnail   String

  // What YouTube gave back. Null until the upload succeeds.
  videoId     String?
  videoUrl    String?
  publishedAt DateTime?

  /// "youtube", or "mock" when no credentials are configured.
  provider String @default("mock")

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([projectId, createdAt])
  @@index([status])
}
