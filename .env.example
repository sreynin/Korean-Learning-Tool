# --- Core -------------------------------------------------------------------
# Public base URL of the app. Used for absolute links and, later, OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI lesson generation ---------------------------------------------------
# Anthropic API key. Leave blank to use the built-in mock generator, which
# returns clearly-labelled sample lessons so the flow works without credentials.
AI_API_KEY=

# Model used for lesson generation.
AI_MODEL=claude-opus-5

# --- Rendering --------------------------------------------------------------
# Font used for on-screen text. Leave blank to search the usual system paths
# for a Korean-capable face; set it if none is found, or to change the look.
RENDER_FONT_PATH=

# --- Voice ------------------------------------------------------------------
# Text-to-speech narration. Blank uses the built-in mock voice provider.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- YouTube publishing -----------------------------------------------------
# OAuth 2.0 client from a Google Cloud project with the YouTube Data API v3
# enabled. Blank uses a mock uploader that puts nothing on YouTube and labels
# every result as a mock, so the publish flow works before you have these.
#
# In Google Cloud, create an "OAuth client ID" of type "Web application" and
# add YOUTUBE_REDIRECT_URI below to its authorised redirect URIs.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Must match the redirect URI registered on the OAuth client exactly.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Encrypts the stored OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
# Without it, connecting an account is refused rather than storing a token in
# plain text. A refresh token can upload to your channel until you revoke it.
YOUTUBE_TOKEN_KEY=

# --- Database ---------------------------------------------------------------
# SQLite file. Relative paths resolve from the project root.
DATABASE_URL="file:./data/korean-learning-lab.db"
